            "description": "Chain verification result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "valid": { "type": "boolean" },
                    "total_events": { "type": "integer" },
                    "genesis_hash": { "type": "string" },
                    "latest_hash": { "type": "string" },
                    "tampered_index": { "type": ["integer", "null"] }
                  }
                }
              }
            }
          }
        }
      }
    }
